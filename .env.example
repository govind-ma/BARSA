# Barsa Platform Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Application Environment (development, testing, production)
BARSA_ENVIRONMENT=development

# Application Debug Mode
BARSA_DEBUG=true

# Server Host & Port
BARSA_HOST=127.0.0.1
BARSA_PORT=8000

# Local Storage Directory (local-first storage for user data)
# Default is .barsa in the current working directory or user home
BARSA_DATA_DIR=.barsa

# Storage Provider Backend (local, s3, github, memory)
# Phase 1 defaults to local
BARSA_STORAGE_PROVIDER=local

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
BARSA_LOG_LEVEL=INFO

# Application Secret Key (Used for internal tokens/signing in future phases)
BARSA_SECRET_KEY=change-me-to-a-secure-random-secret-in-production
