{
  "additionalProperties": false,
  "description": "Represents an AI agent, model configuration, or human collaborator.",
  "properties": {
    "schema_version": {
      "default": "0.1",
      "description": "BMS Schema Version (e.g. '0.1')",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "description": "Globally unique identifier for the record",
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "Arbitrary structured metadata dictionary for custom extensibility",
      "title": "Metadata",
      "type": "object"
    },
    "record_type": {
      "const": "agent",
      "default": "agent",
      "title": "Record Type",
      "type": "string"
    },
    "name": {
      "description": "Human-readable agent name",
      "maxLength": 128,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "provider": {
      "description": "Provider or runtime name (e.g., 'anthropic', 'openai', 'google', 'local')",
      "maxLength": 64,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "capabilities": {
      "description": "List of declared capabilities (e.g. 'coding', 'reasoning')",
      "items": {
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "created_at": {
      "description": "UTC creation timestamp",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Model identifier (e.g. 'claude-3-7-sonnet')",
      "title": "Model"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Agent role description",
      "title": "Description"
    }
  },
  "required": [
    "name",
    "provider"
  ],
  "title": "BMS v0.1 AgentRecord",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}