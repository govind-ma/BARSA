        "id": "dec-order-idempotency",
        "project_id": "prj-order-service",
        "title": "Use Redis-backed Distributed Locks for Idempotent Order Creation",
        "decision": "Use Redisson RLock with a 30-second TTL keyed by client order idempotency key.",
        "rationale": "Prevents double-charging and duplicate order records in high-concurrency payment retries.",
        "status": "approved",
        "created_by": "ag-claude-architect",
        "created_at": "2026-10-13T11:30:00Z",
        "alternatives": [
          "Database UNIQUE constraint on idempotency_token",
          "In-memory Caffeine cache"
        ],
